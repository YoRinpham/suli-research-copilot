# Local development only. Change these values outside a trusted local machine.
POSTGRES_USER=research_copilot
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=research_copilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://research_copilot:local_dev_password@127.0.0.1:5432/research_copilot

# M2 embedding calls use this key; leave empty to run deterministic tests only.
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
# Optional: xhigh, medium, or low. Leave unset to use the provider default.
# QWEN_REASONING_EFFORT=medium
# Set this to the OpenAI-compatible chat/completions endpoint for your workspace and region if required.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MAX_CONTEXT_CHARS=30000
LLM_MAX_INPUT_ITEMS=20
EMBEDDING_MODEL=qwen3.7-text-embedding
# DashScope-native endpoint. Replace the host with your Model Studio workspace/region endpoint when required.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_TOP_K=20
UPLOAD_SIZE_LIMIT_MB=25
# Multipart request ceiling, including form overhead; must exceed the PDF file limit.
REQUEST_BODY_LIMIT_MB=30
PARSE_STALE_AFTER_SECONDS=600
EMBEDDING_STALE_AFTER_SECONDS=600
PAGE_LIMIT=100
STORAGE_ROOT=./data/pdfs
M5_STORAGE_ROOT=./data/m5
CSV_SIZE_LIMIT_MB=5
CSV_ROW_LIMIT=50000
CSV_COLUMN_LIMIT=100
MIN_EXTRACTED_CHARS=30
MIN_TEXT_PAGE_RATIO=0.5
MAX_REPLACEMENT_RATIO=0.05
PROVIDER_TIMEOUT_SECONDS=60
RETRY_COUNT=2
CORS_ORIGIN=http://localhost:3000
